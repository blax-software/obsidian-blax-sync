{
  "name": "obsidian-blax-sync",
  "version": "0.2.0",
  "description": "Sync your vault, plugins and settings to your own WebDAV server. Set up in three steps, add more devices with a QR code. Edits are never missed and nothing is ever hard-deleted.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint src && vitest run",
    "release": "node scripts/release.mjs",
    "lint": "eslint src"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "sync",
    "webdav"
  ],
  "author": "Blax Software (https://blax.at)",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "jsqr": "^1.4.0",
    "obsidian": "latest",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
